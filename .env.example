# Cấu hình biến môi trường cho ứng dụng Flask
# Sao chép file này thành .env và điền giá trị thực

# Khóa bí mật để mã hóa phiên (tạo ngẫu nhiên, cambart trong production)
SECRET_KEY=change_this_to_a_random_secret_key

# URI kết nối database (mặc định SQLite)
# Ví dụ:
# SQLite: sqlite:///site.db
# PostgreSQL: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///site.db
